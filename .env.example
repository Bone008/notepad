# Required: secret that must be entered on a device before it may create vaults.
NOTEPAD_CREATE_SECRET=change-me
# Optional
PORT=3000
NOTEPAD_DATA_DIR=./.data
# NOTEPAD_DB=/data/notepad.sqlite   (defaults to <NOTEPAD_DATA_DIR>/notepad.sqlite; ":memory:" for tests)
# NOTEPAD_TRUST_PROXY=1
# NOTEPAD_MAX_UPDATE_BYTES=1048576
# NOTEPAD_MAX_SNAPSHOT_BYTES=67108864
# NOTEPAD_VAULT_QUOTA_BYTES=268435456
# NOTEPAD_LONGPOLL_MAX_WAIT_MS=25000
# NOTEPAD_PAIR_TTL_SEC=600
